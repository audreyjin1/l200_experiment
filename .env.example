# Google Gemini API Key
# Replace with your actual Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=none

# Model Selection
GEMINI_MODEL=gemini-2.5-flash

# Emergency Dispatch Number
EMERGENCY_PHONE=000

# Google Cloud Project Configuration (Optional for Vertex AI)
GOOGLE_CLOUD_PROJECT=healthcare-adk-prod
GOOGLE_CLOUD_LOCATION=us-central1

# Storage Backend: memory, firestore, or cloud_sql
STORAGE_BACKEND=memory
